RewriteEngine On
DirectoryIndex index.php
Options -Indexes

# Nonaktifkan ModSecurity/WAF untuk proxy SIPKEU (impor Excel sering terblokir)
<IfModule mod_security2.c>
  SecRuleEngine Off
  SecFilterEngine Off
</IfModule>
<IfModule mod_security.c>
  SecRuleEngine Off
</IfModule>
<IfModule LiteSpeed>
  secdisable
</IfModule>

# Blok akses file tersembunyi
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Kompresi & cache aset statis
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png image/jpeg image/webp "access plus 7 days"
  ExpiresByType text/css application/javascript "access plus 1 day"
</IfModule>

# Header keamanan di edge web
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header unset X-Frame-Options
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# WebSocket → Go di localhost:8888 (PHP proxy tidak bisa Upgrade).
# Harus sebelum rewrite ke index.php.
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^cahaya/ws$ ws://127.0.0.1:8888/cahaya/ws [P,L]

# Juga tangkap path tanpa trailing nuance
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^cahaya/ws/?$ ws://127.0.0.1:8888/cahaya/ws [P,L]

# Jangan serve index.html statis — selalu lewat proxy Go
RewriteRule ^index\.html$ index.php [L]

# Jika file/folder statis ada, serve langsung
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Semua request lain → proxy PHP ke Go backend
RewriteRule ^ index.php [L]
